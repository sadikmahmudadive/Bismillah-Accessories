NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (Firebase Admin) credentials
# Option A: Set the three values below using your service account JSON contents
# - The PRIVATE_KEY must have newlines escaped as \n when stored in env vars.
# Example (PowerShell):
#   $key = Get-Content ./serviceAccountKey.json -Raw
#   $key = $key -replace "\r\n", "\\n"
#   setx FIREBASE_ADMIN_PROJECT_ID "<your-project-id>"
#   setx FIREBASE_ADMIN_CLIENT_EMAIL "<client-email@project.iam.gserviceaccount.com>"
#   setx FIREBASE_ADMIN_PRIVATE_KEY "$key"

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Option B (local dev): point to a service account JSON file instead of the three vars
# Example:
# FIREBASE_ADMIN_SDK_PATH=./firebase-adminsdk.json
FIREBASE_ADMIN_SDK_PATH=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

NEXT_PUBLIC_BKASH_MOCK_MODE=true
